# Environment Variables
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database configuration
# For local development with SQLite (zero-config, works everywhere out of the box):
DATABASE_URL="file:./dev.db"

# For PostgreSQL deployment (e.g. Supabase, Neon, local Postgres):
# DATABASE_URL="postgresql://user:password@localhost:5432/lavender_bloom?schema=public"

# Authentication Secrets
JWT_SECRET=lavender_bloom_super_secret_jwt_key_for_teen_privacy_change_in_production
JWT_EXPIRES_IN=7d

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
